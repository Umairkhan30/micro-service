
pipeline {
    agent any

    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/Umairkhan30/micro-service.git'
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('src/emailservice') {
                    sh 'docker build -t emailservice:latest .'
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                withEnv([
                    'AWS_REGION=ap-south-1',
                    'ECR_REGISTRY=777113033512.dkr.ecr.ap-south-1.amazonaws.com',
                    'IMAGE_NAME=emailservice'
                ]) {
                    sh '''
                        set -eu

                        aws ecr get-login-password --region "$AWS_REGION" |
                          docker login --username AWS --password-stdin "$ECR_REGISTRY"

                        docker tag emailservice:latest \
                          "$ECR_REGISTRY/$IMAGE_NAME:$BUILD_NUMBER"

                        docker push "$ECR_REGISTRY/$IMAGE_NAME:$BUILD_NUMBER"
                    '''
                }
            }
        }

        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = 'micro-service'
                GIT_USER_NAME = 'Umairkhan30'
                GIT_EMAIL = 'ru6419435@gmail.com'
                REPO_URL = '777113033512.dkr.ecr.ap-south-1.amazonaws.com/emailservice'
                YAML_FILE = 'emailservice.yaml'
            }

            steps {
                withCredentials([
                    string(credentialsId: 'git-tokan', variable: 'git_token')
                ]) {
                    sh '''
                        set -eu

                        git config user.email "$GIT_EMAIL"
                        git config user.name "$GIT_USER_NAME"

                        cd "$WORKSPACE/kubernetes-files"

                        sed -i "s#image:.*#image: ${REPO_URL}:${BUILD_NUMBER}#" "$YAML_FILE"

                        git add "$YAML_FILE"

                        git commit -m "Update emailservice image to version ${BUILD_NUMBER}"

                        # Use a clean HTTPS URL without embedding the token.
                        git remote set-url origin \
                          "https://github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"

                        # Supply GitHub credentials securely through askpass.
                        cat > "$WORKSPACE/.git-askpass.sh" <<'ASKPASS'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\\n' "$GIT_USER_NAME" ;;
    *Password*) printf '%s\\n' "$git_token" ;;
    *) exit 1 ;;
esac
ASKPASS

                        chmod 700 "$WORKSPACE/.git-askpass.sh"
                        trap 'rm -f "$WORKSPACE/.git-askpass.sh"' EXIT

                        GIT_TERMINAL_PROMPT=0 \
                        GIT_ASKPASS="$WORKSPACE/.git-askpass.sh" \
                        git -c credential.helper= push origin HEAD:master
                    '''
                }
            }
        }
    }
}
